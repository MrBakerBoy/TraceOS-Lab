# =============================================================================
# TraceOS Lab - 环境变量模板
# =============================================================================
# 使用方式: cp .env.example .env 然后编辑 .env 填入实际值
# =============================================================================

# ─── 数据库 ──────────────────────────────────────────────────────────────────
PG_DATABASE=traceos
PG_USER=traceos
PG_PASSWORD=change-me
PG_HOST=postgres
PG_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── NATS ────────────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ─── MinIO 对象存储 ──────────────────────────────────────────────────────────
MINIO_USER=traceos
MINIO_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── 网络 ────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# ─── JWT 认证 (生产环境必须修改!) ─────────────────────────────────────────────
# 生成方式: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-secret-key

# ─── 前端 ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:80
NEXT_PUBLIC_WS_URL=ws://localhost:80

# ─── HuggingFace 镜像 (国内加速) ─────────────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com

# ─── RAG 知识增强 ────────────────────────────────────────────────────────────
RAG_ENABLED=true
RAG_CHAT_ENABLED=true
RAG_DIAGNOSIS_ENABLED=true
RAG_HINTS_ENABLED=true

# ─── AI 服务 ─────────────────────────────────────────────────────────────────
SERVICE_NAME=ai-service
PORT=8000
CORE_SERVICE_URL=http://core-service:8080

# ─── 监控栈 ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_UI_PORT=16686
LOKI_PORT=3100

# ─── 火焰图服务 ──────────────────────────────────────────────────────────────
FLAMEGRAPH_SERVICE_URL=http://172.17.0.1:8765

# ─── 沙箱模式 ────────────────────────────────────────────────────────────────
# "nsjail" (容器隔离) | "local" (直接执行，仅开发)
SANDBOX_MODE=nsjail

# =============================================================================
# LLM 配置 (必填!)
# =============================================================================
# Provider: deepseek-v4 | deepseek | openai | custom
LLM_PROVIDER=deepseek-v4

# 从对应平台获取 API Key
LLM_API_KEY=sk-your-api-key-here

# 可选覆盖 (通常留空使用预设):
# LLM_API_BASE_URL=
# LLM_MODEL=
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
